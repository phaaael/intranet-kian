generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model rp_users {
  userID    Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
}

model rp_phones {
  phoneID  Int    @id @default(autoincrement())
  phone    String @unique
  employee String
  sector   String
  walk     String
}
